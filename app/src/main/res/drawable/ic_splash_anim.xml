<!-- FORK: Sonaro splash icon (replaces Auxio's). Same motion as upstream: a faint outline
of the glyph, then each stroke grows to full width. Shades are one step darker than the
launcher icon because the splash background follows the light/dark theme. -->
<animated-vector xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="432dp"
            android:height="432dp"
            android:viewportWidth="432"
            android:viewportHeight="432">
            <group
                android:scaleX="8.5"
                android:scaleY="8.5"
                android:translateX="114"
                android:translateY="114">
                <path
                    android:fillColor="@android:color/transparent"
                    android:pathData="M12 14.5V20.5M9 3.5V11.5a3 3 0 0 0 6 0V3.5M5.2 4.8Q3.8 7.5 5.2 10.2M18.8 4.8Q20.2 7.5 18.8 10.2"
                    android:strokeWidth="2"
                    android:strokeColor="#80808080"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round" />
            </group>

            <group
                android:scaleX="8.5"
                android:scaleY="8.5"
                android:translateX="114"
                android:translateY="114">
                <path
                    android:name="stem"
                    android:fillColor="@android:color/transparent"
                    android:pathData="M 12,14.5 V 20.5"
                    android:strokeWidth="0"
                    android:strokeColor="#0D9488"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round" />
            </group>

            <group
                android:scaleX="8.5"
                android:scaleY="8.5"
                android:translateX="114"
                android:translateY="114">
                <path
                    android:name="prongs"
                    android:fillColor="@android:color/transparent"
                    android:pathData="M 9,3.5 V 11.5 a 3,3 0 0 0 6,0 V 3.5"
                    android:strokeWidth="0"
                    android:strokeColor="#14B8A6"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round" />
            </group>

            <group
                android:scaleX="8.5"
                android:scaleY="8.5"
                android:translateX="114"
                android:translateY="114">
                <path
                    android:name="arc_left"
                    android:fillColor="@android:color/transparent"
                    android:pathData="M 5.2,4.8 Q 3.8,7.5 5.2,10.2"
                    android:strokeWidth="0"
                    android:strokeColor="#2DD4BF"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round" />
            </group>

            <group
                android:scaleX="8.5"
                android:scaleY="8.5"
                android:translateX="114"
                android:translateY="114">
                <path
                    android:name="arc_right"
                    android:fillColor="@android:color/transparent"
                    android:pathData="M 18.8,4.8 Q 20.2,7.5 18.8,10.2"
                    android:strokeWidth="0"
                    android:strokeColor="#2DD4BF"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="stem">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="850"
                    android:interpolator="@interpolator/m3_sys_motion_easing_emphasized_decelerate"
                    android:propertyName="strokeWidth"
                    android:startOffset="150"
                    android:valueFrom="0"
                    android:valueTo="2"
                    android:valueType="floatType"
                    tools:ignore="PrivateResource" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="prongs">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="850"
                    android:interpolator="@interpolator/m3_sys_motion_easing_emphasized_decelerate"
                    android:propertyName="strokeWidth"
                    android:startOffset="150"
                    android:valueFrom="0"
                    android:valueTo="2"
                    android:valueType="floatType"
                    tools:ignore="PrivateResource" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="arc_left">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="850"
                    android:interpolator="@interpolator/m3_sys_motion_easing_emphasized_decelerate"
                    android:propertyName="strokeWidth"
                    android:startOffset="150"
                    android:valueFrom="0"
                    android:valueTo="2"
                    android:valueType="floatType"
                    tools:ignore="PrivateResource" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="arc_right">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="850"
                    android:interpolator="@interpolator/m3_sys_motion_easing_emphasized_decelerate"
                    android:propertyName="strokeWidth"
                    android:startOffset="150"
                    android:valueFrom="0"
                    android:valueTo="2"
                    android:valueType="floatType"
                    tools:ignore="PrivateResource" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
